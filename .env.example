# Public base URL used for canonical links, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.example.com

# Enquiry delivery. Configure ONE of the options below.
# Until one is set, /api/enquiry returns 503 and the form tells the visitor
# that online enquiries are not connected (nothing is silently discarded).

# Option A: POST the validated enquiry as JSON to a webhook
# (CRM, Zapier, Make, n8n, Google Apps Script, your own backend).
ENQUIRY_WEBHOOK_URL=
# Optional shared secret, sent as the X-Enquiry-Secret header.
ENQUIRY_WEBHOOK_SECRET=

# Option B: send an email through Resend (https://resend.com).
RESEND_API_KEY=
ENQUIRY_EMAIL_TO=
ENQUIRY_EMAIL_FROM=
